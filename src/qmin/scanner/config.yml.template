BaseURL: <base Domain for requests. Must be served by dns server>
Port: 53
Protocol: udp 
RandMax: 10000
LabelDepth: 24
BatchSize: 10000
Round: 5
Timeout: 5000
RetryTimeout: 20000
OutputDir: <path output directory>

iface_name: <interface name>
iface_ip: <ipv4 addr>
iface_ip6: <ipv5 addr>>
dst_port: 53
dns_query_type: TXT
dnssec_enabled: false
log_dnsrecs: false
ends0_enabled: false
ends0_buffer_size: 4096
exclude_ips_fname: exclude_ips.txt
pkts_per_sec: 10
port_min: 61440
port_max: 65535
verbosity: 2